    }
  ],
  "groupAssociation": {
    "middle-agg-coord-channel": "default",
    "global-channel": "default",
    "hier-channel": "default"
  },
  "channels": [
    {
      "name": "middle-agg-coord-channel",
      "description": "Channel between middle aggregator and coordinator",
      "pair": ["middle-aggregator", "coordinator"],
      "groupBy": {
        "type": "tag",
        "value": ["default"]
      },
      "funcTags": {
        "middle-aggregator": ["coordinate"],
        "coordinator": ["coordinateWithMidAgg"]
      }
    },
    {
      "name": "global-channel",
      "description": "Model updates between top aggregator and middle aggregator",
      "pair": ["top-aggregator", "middle-aggregator"],
      "groupBy": {
        "type": "tag",
        "value": ["default"]
      },
      "funcTags": {
        "top-aggregator": ["distribute", "aggregate"],
        "middle-aggregator": ["fetch", "upload"]
      }
    },
    {
      "name": "hier-channel",
      "description": "Model updates between middle aggregator and leaf aggregator",
      "pair": ["middle-aggregator", "leaf-aggregator"],
      "backend": "shm",
      "groupBy": {
        "type": "tag",
        "value": ["default"]
      },
      "funcTags": {
        "middle-aggregator": ["distribute", "aggregate"],
        "leaf-aggregator": ["fetch", "upload"]
      }
    }
  ],
  "dependencies": ["numpy >= 1.2.0"],
  "hyperparameters": {
    "batchSize": 32,
    "learningRate": 0.01,
    "rounds": 5
